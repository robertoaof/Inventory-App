POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=scania
DATABASE_URL=postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}
CORS_ORIGINS=http://localhost:5173
API_ENV=development

# Usados só em produção (docker-compose.prod.yml + frontend/Caddyfile), sem
# efeito em dev. Deixe DOMAIN vazio até ter um domínio apontando para a VPS
# (docs/preparativos-vps.md, seções 5 e 7) — o Caddy cai em HTTP puro na
# porta 80 nesse caso. ACME_EMAIL é opcional (usado pelo Let's Encrypt para
# avisos de expiração de certificado).
DOMAIN=
ACME_EMAIL=
